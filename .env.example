# このファイルを .env.local にコピーして、実際のキーを入れてください。
# .env.local は .gitignore 済みなのでコミットされません。
# キーの発行元: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Supabaseプロジェクトの Project Settings > API から取得。
# anon key は公開前提のキーであり、データ保護は RLS（Row Level Security）が担う。
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
